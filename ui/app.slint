import { Palette } from "std-widgets.slint";

export enum ConnState { off, connecting, on }

export struct ServerItem { name: string, sub: string, ping: string, selected: bool }
export struct SubItem { name: string, url: string, count: int }

// Material 3: baseline-схема (seed #6750A4), светлая и тёмная.
global Theme {
    out property <bool> dark: Palette.color-scheme != ColorScheme.light;
    out property <color> surface: dark ? #141218 : #FEF7FF;
    out property <color> container: dark ? #211F26 : #F3EDF7;
    out property <color> container-high: dark ? #2B2930 : #ECE6F0;
    out property <color> container-highest: dark ? #36343B : #E6E0E9;
    out property <color> on-surface: dark ? #E6E0E9 : #1D1B20;
    out property <color> on-surface-variant: dark ? #CAC4D0 : #49454F;
    out property <color> primary: dark ? #D0BCFF : #6750A4;
    out property <color> on-primary: dark ? #381E72 : #FFFFFF;
    out property <color> primary-container: dark ? #4F378B : #EADDFF;
    out property <color> on-primary-container: dark ? #EADDFF : #21005D;
    out property <color> secondary-container: dark ? #4A4458 : #E8DEF8;
    out property <color> on-secondary-container: dark ? #E8DEF8 : #1D192B;
    out property <color> outline: dark ? #938F99 : #79747E;
    out property <color> inverse-surface: dark ? #E6E0E9 : #322F35;
    out property <color> inverse-on-surface: dark ? #322F35 : #F5EFF7;
}

component IconBtn inherits Rectangle {
    in property <string> icon;
    in property <color> tint: Theme.on-surface-variant;
    callback clicked();
    width: 48px;
    height: 48px;
    border-radius: 24px;
    background: Theme.on-surface.with-alpha(ta.pressed ? 0.12 : ta.has-hover ? 0.08 : 0);
    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 24px;
        height: 24px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icon;
        stroke: root.tint;
        stroke-width: 2px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

component FilledBtn inherits Rectangle {
    in property <string> text;
    callback clicked();
    height: 40px;
    border-radius: 20px;
    background: Theme.primary;
    Text {
        text: root.text;
        color: Theme.on-primary;
        font-size: 14px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Rectangle {
        border-radius: parent.border-radius;
        background: Theme.on-primary.with-alpha(ta.pressed ? 0.12 : ta.has-hover ? 0.08 : 0);
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

component Field inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    callback accepted();
    height: 56px;
    border-radius: 28px;
    background: Theme.surface;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.primary : Theme.outline;
    input := TextInput {
        x: 20px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 40px;
        height: 24px;
        font-size: 16px;
        single-line: true;
        color: Theme.on-surface;
        selection-background-color: Theme.primary-container;
        selection-foreground-color: Theme.on-primary-container;
        accepted => { root.accepted(); }
    }
    if input.text == "": Text {
        x: 20px;
        y: (parent.height - self.height) / 2;
        text: root.placeholder;
        font-size: 16px;
        color: Theme.on-surface-variant;
    }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> active;
    callback clicked();
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 64px;
                height: 32px;
                border-radius: 16px;
                background: root.active ? Theme.secondary-container : Theme.on-surface.with-alpha(ta.has-hover ? 0.08 : 0);
                animate background { duration: 200ms; easing: ease-in-out; }
                Path {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 24px;
                    height: 24px;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: root.icon;
                    stroke: root.active ? Theme.on-secondary-container : Theme.on-surface-variant;
                    stroke-width: 2px;
                    stroke-line-cap: round;
                    stroke-line-join: round;
                }
            }
        }
        Text {
            text: root.label;
            font-size: 12px;
            font-weight: root.active ? 700 : 500;
            horizontal-alignment: center;
            color: root.active ? Theme.on-surface : Theme.on-surface-variant;
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

component ConnectButton inherits Rectangle {
    in property <ConnState> state;
    callback clicked();
    width: 190px;
    height: 190px;
    // Форма «перетекает» из скруглённого квадрата в круг — в духе M3 Expressive.
    border-radius: root.state == ConnState.on ? 95px : 64px;
    background: root.state == ConnState.on ? Theme.primary
        : root.state == ConnState.connecting ? Theme.primary-container
        : Theme.container-highest;
    animate border-radius { duration: 350ms; easing: ease-in-out; }
    animate background { duration: 250ms; easing: ease-in-out; }
    Rectangle {
        border-radius: parent.border-radius;
        background: (root.state == ConnState.on ? Theme.on-primary : Theme.on-surface).with-alpha(ta.pressed ? 0.12 : ta.has-hover ? 0.08 : 0);
    }
    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 72px;
        height: 72px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M12 3v9 M6.4 6.8a8 8 0 1 0 11.2 0";
        stroke: root.state == ConnState.on ? Theme.on-primary
            : root.state == ConnState.connecting ? Theme.on-primary-container
            : Theme.primary;
        stroke-width: 2px;
        stroke-line-cap: round;
        stroke-line-join: round;
        opacity: root.state == ConnState.connecting ? 0.45 + 0.55 * Math.abs(Math.sin(animation-tick() / 700ms * 180deg)) : 1;
    }
    ta := TouchArea {
        enabled: root.state != ConnState.connecting;
        clicked => { root.clicked(); }
    }
}

component ServerRow inherits Rectangle {
    in property <ServerItem> item;
    callback clicked();
    height: 68px;
    border-radius: 20px;
    background: root.item.selected ? Theme.secondary-container : Theme.container;
    animate background { duration: 200ms; }
    Rectangle {
        border-radius: parent.border-radius;
        background: Theme.on-surface.with-alpha(ta.pressed ? 0.12 : ta.has-hover ? 0.06 : 0);
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 11px;
                border-width: 2px;
                border-color: root.item.selected ? Theme.primary : Theme.outline;
                Rectangle {
                    width: root.item.selected ? 10px : 0px;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: Theme.primary;
                    animate width { duration: 150ms; }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.item.name;
                font-size: 16px;
                color: Theme.on-surface;
                overflow: elide;
            }
            Text {
                text: root.item.sub;
                font-size: 12px;
                color: Theme.on-surface-variant;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.item.ping;
                font-size: 13px;
                font-weight: 500;
                color: root.item.selected ? Theme.primary : Theme.on-surface-variant;
            }
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

component PageTitle inherits Text {
    font-size: 28px;
    font-weight: 600;
    color: Theme.on-surface;
}

export component MainWindow inherits Window {
    title: "JustPN";
    preferred-width: 380px;
    preferred-height: 720px;
    min-width: 320px;
    min-height: 560px;
    background: Theme.surface;

    in property <ConnState> conn-state: ConnState.off;
    in property <string> uptime;
    in property <string> note;
    in property <string> message;
    in property <string> selected-name;
    in property <string> selected-ping;
    in property <[ServerItem]> servers;
    in property <[SubItem]> subs;
    in-out property <int> page: 0;

    callback toggle-connect();
    callback select-server(int);
    callback ping-all();
    callback add(string);
    callback refresh-subs();
    callback remove-sub(int);

    VerticalLayout {
        Rectangle {
            vertical-stretch: 1;
            clip: true;

            // ── Подключение ─────────────────────────────────────────────
            if root.page == 0: VerticalLayout {
                padding: 24px;
                spacing: 16px;
                PageTitle { text: "JustPN"; }
                Rectangle {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: center;
                        spacing: 28px;
                        HorizontalLayout {
                            alignment: center;
                            ConnectButton {
                                state: root.conn-state;
                                clicked => { root.toggle-connect(); }
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: root.conn-state == ConnState.on ? "Подключено"
                                    : root.conn-state == ConnState.connecting ? "Подключение…" : "Отключено";
                                font-size: 24px;
                                font-weight: 500;
                                horizontal-alignment: center;
                                color: Theme.on-surface;
                            }
                            Text {
                                text: root.conn-state == ConnState.on ? root.uptime
                                    : root.conn-state == ConnState.connecting ? root.note
                                    : "Нажмите, чтобы подключиться";
                                font-size: 14px;
                                horizontal-alignment: center;
                                color: Theme.on-surface-variant;
                            }
                        }
                    }
                }
                Rectangle {
                    height: 76px;
                    border-radius: 24px;
                    background: Theme.container-high;
                    Rectangle {
                        border-radius: parent.border-radius;
                        background: Theme.on-surface.with-alpha(card-ta.pressed ? 0.12 : card-ta.has-hover ? 0.06 : 0);
                    }
                    HorizontalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: "Сервер";
                                font-size: 12px;
                                color: Theme.on-surface-variant;
                            }
                            Text {
                                text: root.selected-name == "" ? "Не выбран" : root.selected-name;
                                font-size: 16px;
                                font-weight: 500;
                                color: Theme.on-surface;
                                overflow: elide;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.selected-ping;
                                font-size: 13px;
                                font-weight: 500;
                                color: Theme.primary;
                            }
                        }
                    }
                    card-ta := TouchArea {
                        clicked => { root.page = 1; }
                    }
                }
            }

            // ── Серверы ─────────────────────────────────────────────────
            if root.page == 1: VerticalLayout {
                padding: 24px;
                padding-bottom: 0px;
                spacing: 12px;
                HorizontalLayout {
                    PageTitle { text: "Серверы"; }
                    IconBtn {
                        icon: "M13 2L4 14h7l-1 8 10-13h-7z";
                        clicked => { root.ping-all(); }
                    }
                }
                if root.servers.length == 0: Text {
                    vertical-stretch: 1;
                    text: "Серверов пока нет.\nДобавьте подписку на вкладке «Подписки».";
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: 14px;
                    color: Theme.on-surface-variant;
                }
                if root.servers.length > 0: Flickable {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 8px;
                        padding-bottom: 12px;
                        for server[i] in root.servers: ServerRow {
                            item: server;
                            clicked => { root.select-server(i); }
                        }
                    }
                }
            }

            // ── Подписки ────────────────────────────────────────────────
            if root.page == 2: VerticalLayout {
                padding: 24px;
                padding-bottom: 0px;
                spacing: 12px;
                HorizontalLayout {
                    PageTitle { text: "Подписки"; }
                    IconBtn {
                        icon: "M20 12a8 8 0 1 1-2.3-5.7 M20 4v5h-5";
                        clicked => { root.refresh-subs(); }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    link-field := Field {
                        placeholder: "Ссылка на подписку или vless://";
                        accepted => {
                            root.add(self.text);
                            self.text = "";
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        FilledBtn {
                            width: 96px;
                            text: "Добавить";
                            clicked => {
                                root.add(link-field.text);
                                link-field.text = "";
                            }
                        }
                    }
                }
                if root.subs.length == 0: Text {
                    vertical-stretch: 1;
                    text: "Вставьте ссылку на подписку — серверы\nзагрузятся автоматически.";
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: 14px;
                    color: Theme.on-surface-variant;
                }
                if root.subs.length > 0: Flickable {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 8px;
                        padding-bottom: 12px;
                        for sub[i] in root.subs: Rectangle {
                            height: 72px;
                            border-radius: 20px;
                            background: Theme.container;
                            HorizontalLayout {
                                padding-left: 20px;
                                padding-right: 4px;
                                spacing: 8px;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: sub.name;
                                        font-size: 16px;
                                        color: Theme.on-surface;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: sub.count + " серв.";
                                        font-size: 12px;
                                        color: Theme.on-surface-variant;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    IconBtn {
                                        icon: "M5 7h14 M10 11v6 M14 11v6 M6 7l1 13h10l1-13 M9 7V4h6v3";
                                        clicked => { root.remove-sub(i); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Snackbar
            if root.message != "": Rectangle {
                x: 16px;
                y: parent.height - self.height - 16px;
                width: parent.width - 32px;
                height: 48px;
                border-radius: 12px;
                background: Theme.inverse-surface;
                Text {
                    x: 16px;
                    width: parent.width - 32px;
                    height: parent.height;
                    text: root.message;
                    font-size: 14px;
                    color: Theme.inverse-on-surface;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        // Navigation bar
        Rectangle {
            height: 80px;
            background: Theme.container;
            HorizontalLayout {
                NavItem {
                    label: "Подключение";
                    icon: "M12 3v9 M6.4 6.8a8 8 0 1 0 11.2 0";
                    active: root.page == 0;
                    clicked => { root.page = 0; }
                }
                NavItem {
                    label: "Серверы";
                    icon: "M4 6h16 M4 12h16 M4 18h16";
                    active: root.page == 1;
                    clicked => { root.page = 1; }
                }
                NavItem {
                    label: "Подписки";
                    icon: "M5 5a14 14 0 0 1 14 14 M5 11a8 8 0 0 1 8 8 M6 19h.01";
                    active: root.page == 2;
                    clicked => { root.page = 2; }
                }
            }
        }
    }
}
