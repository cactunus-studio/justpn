import { Palette } from "std-widgets.slint";

export enum ConnState { off, connecting, on }

export struct ServerItem { name: string, sub: string, ping: string, selected: bool }
export struct SubItem { name: string, url: string, count: int }

// Material 3: baseline-схема (seed #6750A4), светлая и тёмная.
global Theme {
    out property <bool> dark: Palette.color-scheme != ColorScheme.light;
    out property <color> surface: dark ? #141218 : #FEF7FF;
    out property <color> container: dark ? #211F26 : #F3EDF7;
    out property <color> container-high: dark ? #2B2930 : #ECE6F0;
    out property <color> container-highest: dark ? #36343B : #E6E0E9;
    out property <color> on-surface: dark ? #E6E0E9 : #1D1B20;
    out property <color> on-surface-variant: dark ? #CAC4D0 : #49454F;
    out property <color> primary: dark ? #D0BCFF : #6750A4;
    out property <color> on-primary: dark ? #381E72 : #FFFFFF;
    out property <color> primary-container: dark ? #4F378B : #EADDFF;
    out property <color> on-primary-container: dark ? #EADDFF : #21005D;
    out property <color> secondary-container: dark ? #4A4458 : #E8DEF8;
    out property <color> on-secondary-container: dark ? #E8DEF8 : #1D192B;
    out property <color> outline: dark ? #938F99 : #79747E;
    out property <color> inverse-surface: dark ? #E6E0E9 : #322F35;
    out property <color> inverse-on-surface: dark ? #322F35 : #F5EFF7;
}

component IconBtn inherits Rectangle {
    in property <string> icon;
    in property <color> tint: Theme.on-surface-variant;
    callback clicked();
    width: 48px;
    height: 48px;
    border-radius: 24px;
    background: Theme.on-surface.with-alpha(ta.pressed ? 0.12 : ta.has-hover ? 0.08 : 0);
    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 24px;
        height: 24px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icon;
        stroke: root.tint;
        stroke-width: 2px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

component FilledBtn inherits Rectangle {
    in property <string> text;
    callback clicked();
    height: 40px;
    border-radius: 20px;
    background: Theme.primary;
    Text {
        text: root.text;
        color: Theme.on-primary;
        font-size: 14px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Rectangle {
        border-radius: parent.border-radius;
        background: Theme.on-primary.with-alpha(ta.pressed ? 0.12 : ta.has-hover ? 0.08 : 0);
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

component Field inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    callback accepted();
    callback edited(string);
    height: 56px;
    border-radius: 28px;
    background: Theme.surface;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.primary : Theme.outline;
    input := TextInput {
        x: 20px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 40px;
        height: 24px;
        font-size: 16px;
        single-line: true;
        color: Theme.on-surface;
        selection-background-color: Theme.primary-container;
        selection-foreground-color: Theme.on-primary-container;
        accepted => { root.accepted(); }
        edited => { root.edited(self.text); }
    }
    if input.text == "": Text {
        x: 20px;
        y: (parent.height - self.height) / 2;
        text: root.placeholder;
        font-size: 16px;
        color: Theme.on-surface-variant;
    }
}

component ConnectButton inherits Rectangle {
    in property <ConnState> state;
    callback clicked();
    width: 190px;
    height: 190px;
    // Форма «перетекает» из скруглённого квадрата в круг — в духе M3 Expressive.
    border-radius: root.state == ConnState.on ? 95px : 64px;
    background: root.state == ConnState.on ? Theme.primary
        : root.state == ConnState.connecting ? Theme.primary-container
        : Theme.container-highest;
    animate border-radius { duration: 350ms; easing: ease-in-out; }
    animate background { duration: 250ms; easing: ease-in-out; }
    Rectangle {
        border-radius: parent.border-radius;
        background: (root.state == ConnState.on ? Theme.on-primary : Theme.on-surface).with-alpha(ta.pressed ? 0.12 : ta.has-hover ? 0.08 : 0);
    }
    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 72px;
        height: 72px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M12 3v9 M6.4 6.8a8 8 0 1 0 11.2 0";
        stroke: root.state == ConnState.on ? Theme.on-primary
            : root.state == ConnState.connecting ? Theme.on-primary-container
            : Theme.primary;
        stroke-width: 2px;
        stroke-line-cap: round;
        stroke-line-join: round;
        opacity: root.state == ConnState.connecting ? 0.45 + 0.55 * Math.abs(Math.sin(animation-tick() / 700ms * 180deg)) : 1;
    }
    ta := TouchArea {
        enabled: root.state != ConnState.connecting;
        clicked => { root.clicked(); }
    }
}

export struct HwidItem { name: string, value: string, active: bool, idx: int }

export struct RowItem {
    kind: int,        // 0 — заголовок подписки, 1 — сервер
    title: string,
    subtitle: string,
    ping: string,
    selected: bool,
    expanded: bool,
    idx: int,
}

component Row inherits Rectangle {
    in property <RowItem> item;
    callback clicked();
    callback remove();
    height: root.item.kind == 0 ? 56px : 60px;
    border-radius: root.item.kind == 0 ? 16px : 12px;
    background: root.item.kind == 0 ? Theme.container-high
        : root.item.selected ? Theme.secondary-container : Theme.container;
    animate background { duration: 200ms; }
    Rectangle {
        border-radius: parent.border-radius;
        background: Theme.on-surface.with-alpha(ta.pressed ? 0.12 : ta.has-hover ? 0.06 : 0);
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
    if root.item.kind == 1 && root.item.selected: Rectangle {
        x: 0px;
        y: 12px;
        width: 4px;
        height: parent.height - 24px;
        border-radius: 2px;
        background: Theme.primary;
    }
    if root.item.kind == 0: HorizontalLayout {
        padding-left: 12px;
        padding-right: 4px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Path {
                width: 20px;
                height: 20px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: root.item.expanded ? "M6 9l6 6 6-6" : "M9 6l6 6-6 6";
                stroke: Theme.on-surface-variant;
                stroke-width: 2px;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            Text {
                text: root.item.title;
                font-size: 15px;
                font-weight: 600;
                color: Theme.on-surface;
                overflow: elide;
            }
            Text {
                text: root.item.subtitle;
                font-size: 12px;
                color: Theme.on-surface-variant;
            }
        }
        if root.item.idx >= 0: VerticalLayout {
            alignment: center;
            IconBtn {
                width: 40px;
                height: 40px;
                icon: "M5 7h14 M10 11v6 M14 11v6 M6 7l1 13h10l1-13 M9 7V4h6v3";
                clicked => { root.remove(); }
            }
        }
    }
    if root.item.kind == 1: HorizontalLayout {
        padding-left: 20px;
        padding-right: 16px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.item.title;
                font-size: 15px;
                color: Theme.on-surface;
                overflow: elide;
            }
            Text {
                text: root.item.subtitle;
                font-size: 11px;
                color: Theme.on-surface-variant;
            }
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.item.ping;
                font-size: 13px;
                font-weight: 500;
                color: root.item.selected ? Theme.primary : Theme.on-surface-variant;
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "JustPN";
    preferred-width: 920px;
    preferred-height: 580px;
    min-width: 700px;
    min-height: 460px;
    background: Theme.surface;

    in property <ConnState> conn-state: ConnState.off;
    in property <string> uptime;
    in property <string> note;
    in property <string> message;
    in property <string> selected-name;
    in property <string> selected-info;
    in property <string> selected-ping;
    in property <[RowItem]> rows;
    in-out property <bool> show-add: false;
    in-out property <bool> show-settings: false;
    in-out property <bool> send-hwid: false;
    in-out property <int> user-agent: 0;
    in property <string> hwid;
    in property <[HwidItem]> hwids;
    in-out property <bool> show-hwids: false;
    callback hwid-select(int);
    callback hwid-generate();
    callback hwid-add(string);
    callback hwid-remove(int);
    callback settings-changed(bool, int);

    callback toggle-connect();
    callback select-server(int);
    callback toggle-group(int);
    callback remove-sub(int);
    callback search(string);
    callback ping-all();
    callback add(string);
    callback refresh-subs();

    HorizontalLayout {
        // Левая панель: серверы
        Rectangle {
            horizontal-stretch: 1.1;
            min-width: 340px;
            clip: true;
            VerticalLayout {
                padding: 20px;
                padding-bottom: 0px;
                spacing: 12px;
                Text {
                    text: "Серверы";
                    font-size: 28px;
                    font-weight: 600;
                    color: Theme.on-surface;
                }
                HorizontalLayout {
                    spacing: 2px;
                    Field {
                        height: 48px;
                        border-radius: 24px;
                        placeholder: "Поиск серверов";
                        edited(t) => { root.search(t); }
                    }
                    IconBtn {
                        icon: "M13 2L4 14h7l-1 8 10-13h-7z";
                        clicked => { root.ping-all(); }
                    }
                    IconBtn {
                        icon: "M20 12a8 8 0 1 1-2.3-5.7 M20 4v5h-5";
                        clicked => { root.refresh-subs(); }
                    }
                    IconBtn {
                        icon: root.show-add ? "M6 6l12 12 M18 6L6 18" : "M12 5v14 M5 12h14";
                        tint: Theme.primary;
                        clicked => { root.show-add = !root.show-add; }
                    }
                }
                if root.show-add: HorizontalLayout {
                    spacing: 8px;
                    link-field := Field {
                        height: 48px;
                        border-radius: 24px;
                        placeholder: "Ссылка на подписку или vless://";
                        accepted => {
                            root.add(self.text);
                            self.text = "";
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        FilledBtn {
                            width: 96px;
                            text: "Добавить";
                            clicked => {
                                root.add(link-field.text);
                                link-field.text = "";
                            }
                        }
                    }
                }
                if root.rows.length == 0: Text {
                    vertical-stretch: 1;
                    text: "Серверов пока нет.\nНажмите «+» и вставьте ссылку на подписку.";
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: 14px;
                    color: Theme.on-surface-variant;
                }
                if root.rows.length > 0: Flickable {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 4px;
                        padding-bottom: 12px;
                        for row[i] in root.rows: Row {
                            item: row;
                            clicked => {
                                if (row.kind == 0) { root.toggle-group(row.idx); }
                                else { root.select-server(row.idx); }
                            }
                            remove => { root.remove-sub(row.idx); }
                        }
                    }
                }
            }
        }

        // Правая панель: подключение
        Rectangle {
            horizontal-stretch: 1;
            min-width: 300px;
            background: Theme.container;
            VerticalLayout {
                padding: 24px;
                spacing: 16px;
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    IconBtn {
                        icon: "M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3h0a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5h0a1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8v0a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z";
                        clicked => { root.show-settings = true; }
                    }
                    Rectangle {
                        height: 36px;
                        width: 200px;
                        border-radius: 12px;
                        background: Theme.container-highest;
                        Text {
                            text: "Системный прокси · Xray";
                            font-size: 13px;
                            color: Theme.on-surface-variant;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: center;
                        spacing: 24px;
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 240px;
                                height: 240px;
                                border-radius: 120px;
                                border-width: 1px;
                                border-color: Theme.primary.with-alpha(root.conn-state == ConnState.on ? 0.4 : 0.0);
                                animate border-color { duration: 300ms; }
                                ConnectButton {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    state: root.conn-state;
                                    clicked => { root.toggle-connect(); }
                                }
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: root.conn-state == ConnState.on ? "Подключено"
                                    : root.conn-state == ConnState.connecting ? "Подключение…" : "Отключено";
                                font-size: 24px;
                                font-weight: 500;
                                horizontal-alignment: center;
                                color: Theme.on-surface;
                            }
                            Text {
                                text: root.conn-state == ConnState.on ? root.uptime
                                    : root.conn-state == ConnState.connecting ? root.note
                                    : "Нажмите, чтобы подключиться";
                                font-size: 14px;
                                horizontal-alignment: center;
                                color: Theme.on-surface-variant;
                            }
                        }
                    }
                }
                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: root.selected-name == "" ? "Сервер не выбран" : root.selected-name;
                        font-size: 16px;
                        font-weight: 500;
                        horizontal-alignment: center;
                        color: Theme.on-surface;
                        overflow: elide;
                    }
                    Text {
                        text: root.selected-info + (root.selected-ping == "" ? "" : "  ·  " + root.selected-ping);
                        font-size: 12px;
                        horizontal-alignment: center;
                        color: Theme.on-surface-variant;
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    FilledBtn {
                        width: 200px;
                        height: 44px;
                        border-radius: 22px;
                        text: "Тест пинга";
                        clicked => { root.ping-all(); }
                    }
                }
            }

            if root.message != "": Rectangle {
                x: 16px;
                y: parent.height - self.height - 16px;
                width: parent.width - 32px;
                height: 48px;
                border-radius: 12px;
                background: Theme.inverse-surface;
                Text {
                    x: 16px;
                    width: parent.width - 32px;
                    height: parent.height;
                    text: root.message;
                    font-size: 14px;
                    color: Theme.inverse-on-surface;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }

    if root.show-settings: Rectangle {
        background: #000000.with-alpha(0.5);
        TouchArea {
            clicked => { root.show-settings = false; }
        }
        Rectangle {
            width: min(parent.width - 48px, 420px);
            height: lay.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 28px;
            background: Theme.container-high;
            TouchArea { }
            lay := VerticalLayout {
                padding: 24px;
                spacing: 20px;
                Text {
                    text: "Настройки";
                    font-size: 24px;
                    color: Theme.on-surface;
                }
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "Отправлять HWID";
                            font-size: 16px;
                            color: Theme.on-surface;
                        }
                        Text {
                            text: "ID устройства: " + root.hwid;
                            font-size: 11px;
                            color: Theme.on-surface-variant;
                            overflow: elide;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 52px;
                            height: 32px;
                            border-radius: 16px;
                            background: root.send-hwid ? Theme.primary : Theme.container-highest;
                            border-width: root.send-hwid ? 0px : 2px;
                            border-color: Theme.outline;
                            animate background { duration: 200ms; }
                            Rectangle {
                                width: root.send-hwid ? 24px : 16px;
                                height: self.width;
                                border-radius: self.width / 2;
                                x: root.send-hwid ? parent.width - self.width - 4px : 8px;
                                y: (parent.height - self.height) / 2;
                                background: root.send-hwid ? Theme.on-primary : Theme.outline;
                                animate x, width { duration: 200ms; easing: ease-in-out; }
                            }
                            TouchArea {
                                clicked => {
                                    root.send-hwid = !root.send-hwid;
                                    root.settings-changed(root.send-hwid, root.user-agent);
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    FilledBtn {
                        width: 200px;
                        text: "Менеджер HWID";
                        clicked => { root.show-hwids = true; }
                    }
                }
                VerticalLayout {
                    spacing: 10px;
                    Text {
                        text: "User-Agent";
                        font-size: 16px;
                        color: Theme.on-surface;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        for name[i] in ["Xray", "Happ", "Incy"]: Rectangle {
                            height: 40px;
                            border-radius: 12px;
                            background: root.user-agent == i ? Theme.secondary-container : transparent;
                            border-width: root.user-agent == i ? 0px : 1px;
                            border-color: Theme.outline;
                            animate background { duration: 200ms; }
                            Text {
                                text: name;
                                font-size: 14px;
                                font-weight: 500;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                color: root.user-agent == i ? Theme.on-secondary-container : Theme.on-surface-variant;
                            }
                            TouchArea {
                                clicked => {
                                    root.user-agent = i;
                                    root.settings-changed(root.send-hwid, i);
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    FilledBtn {
                        width: 96px;
                        text: "Готово";
                        clicked => { root.show-settings = false; }
                    }
                }
            }
        }
    }

    if root.show-hwids: Rectangle {
        background: #000000.with-alpha(0.5);
        TouchArea {
            clicked => { root.show-hwids = false; }
        }
        Rectangle {
            width: min(parent.width - 48px, 460px);
            height: hl.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 28px;
            background: Theme.container-high;
            TouchArea { }
            hl := VerticalLayout {
                padding: 24px;
                spacing: 14px;
                Text {
                    text: "Менеджер HWID";
                    font-size: 24px;
                    color: Theme.on-surface;
                }
                Text {
                    text: "Активный HWID уходит в заголовке x-hwid при загрузке подписки. Не используйте подмену, чтобы обходить лимит устройств у провайдера — это может нарушать его условия.";
                    font-size: 12px;
                    wrap: word-wrap;
                    color: Theme.on-surface-variant;
                }
                Flickable {
                    height: 190px;
                    VerticalLayout {
                        spacing: 6px;
                        for h in root.hwids: Rectangle {
                            height: 56px;
                            border-radius: 14px;
                            background: h.active ? Theme.secondary-container : Theme.container;
                            animate background { duration: 200ms; }
                            TouchArea {
                                clicked => { root.hwid-select(h.idx); }
                            }
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 4px;
                                spacing: 10px;
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 20px;
                                        height: 20px;
                                        border-radius: 10px;
                                        border-width: 2px;
                                        border-color: h.active ? Theme.primary : Theme.outline;
                                        Rectangle {
                                            width: h.active ? 8px : 0px;
                                            height: self.width;
                                            border-radius: self.width / 2;
                                            x: (parent.width - self.width) / 2 - 2px;
                                            y: (parent.height - self.height) / 2 - 2px;
                                            background: Theme.primary;
                                        }
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 1px;
                                    Text {
                                        text: h.name;
                                        font-size: 14px;
                                        color: Theme.on-surface;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: h.value;
                                        font-size: 11px;
                                        color: Theme.on-surface-variant;
                                        overflow: elide;
                                    }
                                }
                                if h.idx >= 0: VerticalLayout {
                                    alignment: center;
                                    IconBtn {
                                        width: 40px;
                                        height: 40px;
                                        icon: "M5 7h14 M10 11v6 M14 11v6 M6 7l1 13h10l1-13 M9 7V4h6v3";
                                        clicked => { root.hwid-remove(h.idx); }
                                    }
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    hwid-field := Field {
                        height: 48px;
                        border-radius: 24px;
                        placeholder: "Свой HWID";
                        accepted => {
                            root.hwid-add(self.text);
                            self.text = "";
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        FilledBtn {
                            width: 96px;
                            text: "Добавить";
                            clicked => {
                                root.hwid-add(hwid-field.text);
                                hwid-field.text = "";
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    FilledBtn {
                        width: 190px;
                        text: "Сгенерировать случайный";
                        clicked => { root.hwid-generate(); }
                    }
                    FilledBtn {
                        width: 96px;
                        text: "Готово";
                        clicked => { root.show-hwids = false; }
                    }
                }
            }
        }
    }
}
